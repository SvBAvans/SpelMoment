
@model HomeViewModel

@{
    ViewData["Title"] = "Home";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moment-card.css" asp-append-version="true" />
}

<section class="home-hero">
    <div class="container">
        <div class="hero-content">
            <span class="hero-label">
                Samen spelen, samen leren
            </span>

            <h1> Leer Nederlands.<span>Maak nieuwe vrienden.</span></h1>

            <p>
                Ontmoet nieuwe mensen, speel gezellige
                bordspellen en oefen spelenderwijs je
                Nederlands. Iedereen is welkom!
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a href="#moments" class="btn btn-primary btn-lg">Bekijk spelavonden</a>

                @if (!isLoggedIn)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                        Maak een account
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="intro-section py-5">
    <div class="container text-center">
        <span class="section-label">Welkom</span>
        <h2 class="section-title">Samen is leren leuker!</h2>

        <p class="intro-text mx-auto">
            Nederlands leren hoeft niet moeilijk of saai
            te zijn. Tijdens onze bordspelavonden ontmoet
            je nieuwe mensen, oefen je de taal en beleef
            je een gezellige avond.
        </p>

        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🎲</div>
                    <h3>Speel samen</h3>
                    <p>
                        Ontdek leuke bordspellen en
                        beleef gezellige momenten.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">💬</div>
                    <h3>Leer Nederlands</h3>
                    <p>
                        Oefen nieuwe woorden en zinnen
                        in een ontspannen omgeving.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🤝</div>
                    <h3>Maak vrienden</h3>
                    <p>
                        Leer mensen kennen en bouw
                        nieuwe vriendschappen op.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="moments" class="moments-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Doe gezellig mee</span>

            <h2 class="section-title">Aankomende spelavonden</h2>

            <p class="text-muted">
                Kies een spelavond die bij jou past
                en ontdek hoe leuk samen spelen is.
            </p>
        </div>

        
        @if (Model.SuggestedMoments?.Any() == true)
        {
            <div class="row g-4">
                @foreach (var moment in Model.SuggestedMoments)
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_MomentCard" model="moment" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state text-center">
                <div class="mb-3" style="font-size: 3rem;">🎲</div>
                <h3>Nog geen spelavonden gepland</h3>
                <p class="text-muted">
                    Er zijn momenteel geen spelavonden beschikbaar. Kom later terug!
                </p>
            </div>
        }

    </div>
</section>

<section class="join-section py-5">
    <div class="container text-center">
        <h2>Klaar om mee te spelen?</h2>

        <p>
            Een gezellige avond, nieuwe vrienden
            en Nederlands oefenen.
            Wat wil je nog meer?
        </p>

        @if (!isLoggedIn)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                Meld je gratis aan
            </a>
        }
        else
        {
            <a href="#moments" class="btn btn-light btn-lg">
                Ontdek de spelavonden
            </a>
        }
    </div>
</section>
