@using System.Collections.Specialized
@{
    
}

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow">
        <div class="container-fluid">
            <a href="@Url.ActionLink("Index", "Home")" class="navbar-brand" style="white-space: normal; text-align: center; word-break: break-all;color: var(--bs-body-color);">SpelMoment</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end me-5">
            <ul class="navbar-nav nav flex-grow-1">
                <li class="nav-item"><a class="nav-link">Mijn inschrijvingen</a></li>
            </ul>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn account-dropdown dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>Welkom @ViewBag.FirstName</span>
                    </button>
                    <ul class="dropdown-menu">
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-action="Logout" asp-controller="Account">Logout</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-primary" asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Context.Request.Path">Login</a>
            }
            
            @* <div class="dropdown text-end"> *@
            @*     <a></a> *@
            @* </div> *@
        </div>
    </nav>
</header>
