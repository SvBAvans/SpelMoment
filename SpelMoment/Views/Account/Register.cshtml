@model RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Registreren - SpelMoment</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/register.css"
          asp-append-version="true" />
</head>

<body>
    <main class="container register-container">
        <div class="card register-card shadow-sm">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="text-decoration-none brand-title">
                        🎲 SpelMoment
                    </a>

                    <h1 class="h3 fw-bold mt-3 mb-2">
                        Account aanmaken
                    </h1>

                    <p class="text-muted">
                        Registreer je en ontdek gezellige spelavonden.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">
                    </div>

                    <input type="hidden" asp-for="ReturnUrl" />

                    <h2 class="h5 mb-3">Persoonlijke gegevens</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">
                                Voornaam
                            </label>

                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" required />

                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">
                                Achternaam
                            </label>

                            <input asp-for="LastName" class="form-control" autocomplete="family-name" required />

                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            E-mailadres
                        </label>

                        <input asp-for="Email" type="email" class="form-control" placeholder="naam@voorbeeld.nl"
                               autocomplete="email" required />

                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Birthday" class="form-label">
                                Geboortedatum
                            </label>

                            <input asp-for="Birthday" type="date" class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />

                            <span asp-validation-for="Birthday" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label">
                                Geslacht
                            </label>

                            <select asp-for="Gender" class="form-select" required>
                                <option value="@SpelMoment.Domain.Model.User.GenderEnum.Male">
                                    Man
                                </option>
                                <option value="@SpelMoment.Domain.Model.User.GenderEnum.Female">
                                    Vrouw
                                </option>
                                <option value="@SpelMoment.Domain.Model.User.GenderEnum.Other">
                                    Anders
                                </option>
                            </select>

                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <h2 class="h5 mt-4 mb-3">Wachtwoord</h2>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            Wachtwoord
                        </label>

                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required />

                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordConfirmation" class="form-label">
                            Bevestig wachtwoord
                        </label>

                        <input asp-for="PasswordConfirmation" type="password" class="form-control" autocomplete="new-password"
                               required />

                        <span asp-validation-for="PasswordConfirmation" class="text-danger small"></span>
                    </div>

                    <h2 class="h5 mt-4 mb-3">Dieetwensen</h2>

                    <div class="mb-3">
                        <div class="form-check mb-2">
                            <input asp-for="HasLactoseIntolerance" class="form-check-input" />
                            <label asp-for="HasLactoseIntolerance" class="form-check-label">
                                Lactose-intolerant
                            </label>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="HasNutAllergy" class="form-check-input" />
                            <label asp-for="HasNutAllergy" class="form-check-label">
                                Notenallergie
                            </label>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="IsVegetarian" class="form-check-input" />
                            <label asp-for="IsVegetarian" class="form-check-label">
                                Vegetarisch
                            </label>
                        </div>

                        <div class="form-check">
                            <input asp-for="DrinksAlcohol"class="form-check-input" />
                            <label asp-for="DrinksAlcohol" class="form-check-label">
                                Ik drink alcohol
                            </label>
                        </div>
                    </div>

                    <h2 class="h5 mt-4 mb-3">Adres</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Address.Street" class="form-label">
                                Straat
                            </label>

                            <input asp-for="Address.Street" class="form-control" placeholder="Straatnaam" />

                            <span asp-validation-for="Address.Street" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Address.HouseNumber" class="form-label">
                                Huisnummer
                            </label>

                            <input asp-for="Address.HouseNumber" class="form-control" placeholder="123" />

                            <span asp-validation-for="Address.HouseNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address.City" class="form-label">
                            Stad
                        </label>

                        <input asp-for="Address.City" class="form-control" placeholder="Stad" />

                        <span asp-validation-for="Address.City" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Registreren
                    </button>

                    <p class="text-center mt-4 mb-0">
                        Heb je al een account?
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">
                            Inloggen
                        </a>
                    </p>

                    <div class="text-center mt-3">
                        <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                            ← Terug naar home
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const birthday = document.getElementById("Birthday");
            const drinksAlcohol = document.getElementById("DrinksAlcohol");

            if (!birthday || !drinksAlcohol) return;

            function updateAlcohol() {
                if (!birthday.value) {
                    drinksAlcohol.checked = false;
                    drinksAlcohol.disabled = true;
                    return;
                }

                const [year, month, day] =
                    birthday.value.split("-").map(Number);

                const today = new Date();

                let age = today.getFullYear() - year;

                if (
                    today.getMonth() + 1 < month ||
                    (today.getMonth() + 1 === month &&
                     today.getDate() < day)
                ) {
                    age--;
                }

                if (age < 18) {
                    drinksAlcohol.checked = false;
                    drinksAlcohol.disabled = true;
                } else {
                    drinksAlcohol.disabled = false;
                }
            }

            birthday.addEventListener("change", updateAlcohol);
            updateAlcohol();
        });
    </script>
</body>
</html>
