
@using System.Security.Claims
@using SpelMoment.Domain.Model
@model SpelMoment.Domain.Model.Moment

@{
    ViewData["Title"] = "Spelavond bekijken";
    var playerCount = Model.Players.Count;
    var availablePlaces = Math.Max(0, Model.MaxPlayers - playerCount);
    var is18Plus = Model.Is18Plus || Model.Games.Any(game => game.Is18Plus);
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var identityId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isRegistered = Model.Players.Any(player => player.IdentityId == identityId);
    var isOrganiser = Model.Organiser?.IdentityId == identityId && identityId != null;
    var dietWarnings = ViewBag.DietWarnings as List<string> ?? new List<string>();
    
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    bool canReview = ViewBag.CanReview == true;
}

<div class="container py-4">
    <a asp-controller="Moments" asp-action="Index" class="text-decoration-none d-inline-block mb-3">
        ← Terug naar spelmomenten
    </a>

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="mb-1">@Model.DateTime.ToString("dddd d MMMM yyyy")</h1>
            <p class="text-muted mb-0">Een gezellige avond vol bordspellen en Nederlands oefenen.</p>
        </div>

        @if (is18Plus)
        {
            <span class="badge bg-danger">18+</span>
        }
    </div>
    
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="mb-3">Over deze spelavond</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>📅 Datum en tijd</strong>
                            <p class="mb-0">@Model.DateTime.ToString("dddd d MMMM yyyy") om @Model.DateTime.ToString("HH:mm") uur</p>
                        </div>

                        <div class="col-md-6">
                            <strong>📍 Locatie</strong>
                            <p class="mb-0">@Model.Address.ToDisplayString()</p>
                        </div>

                        <div class="col-md-6">
                            <strong>👤 Organisator</strong>

                            <p class="mb-1">
                                @(Model.Organiser?.ToDisplayString() ?? "Onbekend")
                            </p>

                            @if (Model.Organiser != null)
                            {
                                <div class="small text-muted mb-1">
                                    🎲 @ViewBag.OrganisedMomentCount spelavonden georganiseerd
                                </div>

                                @if (ViewBag.OrganiserReviewCount > 0)
                                {
                                    <div>
                                        <span class="text-warning">★</span>

                                        <strong>
                                            @(((double)ViewBag.OrganiserAverageRating).ToString("0.0")) / 5
                                        </strong>

                                        <span class="text-muted small">
                                            (@ViewBag.OrganiserReviewCount reviews)
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Nog geen beoordelingen
                                    </span>
                                }
                            }
                        </div>

                        <div class="col-md-6">
                            <strong>👥 Deelnemers</strong>
                            <p class="mb-0">@playerCount / @Model.MaxPlayers aangemeld</p>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="mb-3">Bordspellen</h4>

            @if (!Model.Games.Any())
            {
                <div class="alert alert-light border">Er zijn nog geen bordspellen toegevoegd.</div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    @foreach (var game in Model.Games)
                    {
                        <div class="col-md-6">
                            <div class="card h-100">
                                @if (!string.IsNullOrWhiteSpace(game.ImageUrl))
                                {
                                    <img src="@game.ImageUrl" alt="@game.Name" class="card-img-top" style="height: 180px; object-fit: cover;" />
                                }

                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <h5 class="card-title mb-0">@game.Name</h5>

                                        @if (game.Is18Plus)
                                        {
                                            <span class="badge bg-danger">18+</span>
                                        }
                                    </div>

                                    <p class="text-muted">@game.Description</p>

                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border">@game.Genre</span>
                                        <span class="badge bg-light text-dark border">@game.Type</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    
                    @if (!isOrganiser)
                    {
                        <h4 class="mb-3">Meedoen?</h4>
                    }

                    @if (isOrganiser)
                    {
                        @if (playerCount == 0)
                        {
                            <div class="d-grid gap-2">
                                <a asp-controller="Moments" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                                    Bewerken
                                </a>

                                <form asp-controller="Moments" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                                      onsubmit="return confirm('Weet je zeker dat je dit spelmoment wilt verwijderen?');">
                                    <button type="submit" class="btn btn-outline-danger w-100">Verwijderen</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Je kunt dit spelmoment niet meer bewerken of verwijderen, omdat er al deelnemers zijn aangemeld.
                            </p>
                        }
                    }
                    else if (isRegistered)
                    {
                        <form asp-controller="Moments" asp-action="Leave" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100">Afmelden</button>
                        </form>
                    }
                    else if (availablePlaces == 0)
                    {
                        <button class="btn btn-secondary w-100" disabled>Spelavond is vol</button>
                    }
                    else if (isLoggedIn)
                    {
                        @if (dietWarnings.Any())
                        {
                            <div class="alert alert-warning" role="alert">
                                <strong>Let op: niet alle dieetwensen worden ondersteund.</strong>

                                <ul class="mb-0 mt-2">
                                    @foreach (var warning in dietWarnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        <form asp-controller="Moments" asp-action="Join" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-primary w-100">Aanmelden</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                           class="btn btn-primary w-100">
                            Log in om mee te doen
                        </a>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="mb-3">Eten en drinken</h4>
                    <p class="text-muted small">Tijdens deze spelavond zijn de volgende opties beschikbaar:</p>

                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.IsVegetarianFriendly)
                        {
                            <span class="badge bg-light text-dark border">🌱 Vegetarisch</span>
                        }

                        @if (Model.IsLactoseIntoleranceFriendly)
                        {
                            <span class="badge bg-light text-dark border">🥛 Lactosevrij</span>
                        }

                        @if (Model.IsNutAllergyFriendly)
                        {
                            <span class="badge bg-light text-dark border">🥜 Notenvrij</span>
                        }

                        @if (Model.IsNonAlcoholicFriendly)
                        {
                            <span class="badge bg-light text-dark border">🥤 Alcoholvrij</span>
                        }

                        @if (!Model.IsVegetarianFriendly && !Model.IsLactoseIntoleranceFriendly &&
                             !Model.IsNutAllergyFriendly && !Model.IsNonAlcoholicFriendly)
                        {
                            <span class="text-muted">Geen specifieke opties opgegeven.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm mt-4">
    <div class="card-body">
        <h3 class="mb-3">Reviews</h3>

        @if (!reviews.Any())
        {
            <p class="text-muted">
                Er zijn nog geen reviews voor deze spelavond.
            </p>
        }
        else
        {
            @foreach (var review in reviews)
            {
                <div class="border-bottom pb-3 mb-3">
                    <div class="d-flex justify-content-between">
                        <strong>
                            @review.Reviewer.FirstName
                            @review.Reviewer.LastName
                        </strong>

                        <span class="text-warning">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <span>★</span>
                            }
                        </span>
                    </div>

                    <p class="mb-0 mt-2">@review.Text</p>
                </div>
            }
        }

        @if (canReview)
        {
            <h4 class="mt-4">Schrijf een review</h4>

            <form asp-controller="Moments"
                  asp-action="AddReview"
                  method="post">

                <input type="hidden"
                       name="MomentId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">Beoordeling</label>

                    <select name="Rating"
                            class="form-select"
                            required>
                        <option value="">Kies een score</option>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i sterren</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Review</label>

                    <textarea name="Text"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <button type="submit"
                        class="btn text-white"
                        style="background-color: #1e6a41;">
                    Review plaatsen
                </button>
            </form>
        }
    </div>
</div>
    </div>
</div>
