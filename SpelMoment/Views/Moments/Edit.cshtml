@model SpelMoment.Models.CreateMomentViewModel

@{
    ViewData["Title"] = "Spelmoment bewerken";
    var momentId = ViewContext.RouteData.Values["id"];
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1 class="mb-2">Spelmoment bewerken</h1>
            <p class="text-muted mb-4">Pas de gegevens en bordspellen van je spelavond aan.</p>

            <form asp-controller="Moments" asp-action="Edit" asp-route-id="@momentId" method="post">
                @Html.AntiForgeryToken()
                <partial name="_MomentForm" model="Model" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Moments" asp-action="Details" asp-route-id="@momentId"
                       class="btn btn-outline-secondary">Annuleren</a>

                    <button type="submit" class="btn text-white" style="background-color: #1e6a41;">
                        Wijzigingen opslaan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/moment-form.js" asp-append-version="true"></script>
}